#!/usr/bin/env bash

PI_SKIP_VERSION_CHECK=1

mkdir -p \
    "$HOME/.pi/pi-chrome/agent"

GITCONFIG_MOUNT=()
if [ -f "$HOME/.pi/.gitconfig" ]; then
    GITCONFIG_MOUNT=(-v "$HOME/.pi/.gitconfig":"/home/node/.gitconfig")
else
    echo "提示: 未找到 $HOME/.pi/.gitconfig，跳过 git 全局配置挂载" >&2
fi

SHADOWSOCKS_MOUNT=()
if [ -f "$HOME/Documents/programs/shadowsocks/config.json" ]; then
    SHADOWSOCKS_MOUNT=(-v "$HOME/Documents/programs/shadowsocks/config.json":"/etc/shadowsocks-libev/config.json")
else
    echo "提示: 未找到 $HOME/Documents/programs/shadowsocks/config.json，跳过网络代理配置挂载" >&2
fi

docker run --rm -it \
  -u $(id -u):$(id -g) \
  -v "$HOME/.pi/pi-chrome/agent/":"/home/node/.pi/agent/" \
  "${SHADOWSOCKS_MOUNT[@]}" \
  "${GITCONFIG_MOUNT[@]}" \
  -v "$PWD":"/workspace" \
  -w /workspace \
  -e PI_SKIP_VERSION_CHECK="$PI_SKIP_VERSION_CHECK" \
  -p 127.0.0.1:6080:6080 \
  --shm-size=2g \
  --security-opt seccomp=unconfined \
  pi-chrome:latest
